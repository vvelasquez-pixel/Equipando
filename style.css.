/* Configuración básica y tipografía */
body {
  margin: 0;
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  background-color: #0f172a;
  color: #f8fafc;
  line-height: 1.6;
}

/* Encabezado */
.hero {
  background: linear-gradient(135deg, #1e293b, #0f172a);
  padding: 60px 20px;
  text-align: center;
  border-bottom: 1px solid #334155;
}

h1 {
  font-size: 2.5rem;
  margin-bottom: 10px;
}

h1 span, h2 span {
  color: #38bdf8; /* Color azul claro destacado */
}

.subtitle {
  color: #94a3b8;
  font-size: 1.2rem;
}

/* Indicadores de horas/modalidad */
.badges {
  display: flex;
  justify-content: center;
  gap: 20px;
  margin: 25px 0;
}

.badge {
  background-color: #1e293b;
  padding: 10px 20px;
  border-radius: 8px;
  border: 1px solid #334155;
}

.badge b {
  display: block;
  font-size: 1.3rem;
  color: #38bdf8;
}

/* Navegación */
.nav-links {
  margin-top: 20px;
}

.nav-links a {
  color: #e2e8f0;
  text-decoration: none;
  margin: 0 15px;
  font-weight: 600;
}

.nav-links a:hover {
  color: #38bdf8;
}

/* Contenido Principal */
.container {
  max-width: 900px;
  margin: 0 auto;
  padding: 20px;
}

.card {
  background-color: #1e293b;
  padding: 30px;
  border-radius: 12px;
  margin-top: 30px;
  border: 1px solid #334155;
}

.tag {
  color: #38bdf8;
  font-size: 0.85rem;
  text-transform: uppercase;
  font-weight: bold;
}

/* Comparativa tipo cajas */
.comparativa {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  margin-top: 20px;
}

.box {
  padding: 15px;
  border-radius: 8px;
}

.sin-programa {
  background-color: #291e29;
  border-left: 4px solid #f43f5e;
}

.con-programa {
  background-color: #1e2e29;
  border-left: 4px solid #10b981;
}

footer {
  text-align: center;
  padding: 30px;
  color: #64748b;
  font-size: 0.9rem;
}
